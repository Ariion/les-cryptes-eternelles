rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sauvegarde privée (profils/persos) — uniquement le propriétaire.
    match /users/{userId}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Classement mondial — lecture publique (même sans connexion),
    // écriture uniquement par le joueur concerné, avec des bornes
    // cohérentes avec Integrity côté client (niveau 1-30, étage 0-10 :
    // certaines zones tardives — Château Maudit, Cité Oubliée, Gouffre
    // Astral, Cryptes Profondes — comptent jusqu'à 10 étages).
    // hasOnly() interdit tout champ hors schéma (anti-bloat/anti-abus) ;
    // race/cls sont bornés en taille ; talents/equipped doivent rester
    // des maps (pas de chaîne arbitraire géante).
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name','race','cls','level','bestFloor','talents','equipped','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.race is string
        && request.resource.data.race.size() <= 20
        && request.resource.data.cls is string
        && request.resource.data.cls.size() <= 20
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 30
        && request.resource.data.bestFloor is int
        && request.resource.data.bestFloor >= 0 && request.resource.data.bestFloor <= 10
        && (!('talents' in request.resource.data) || request.resource.data.talents is map)
        && (!('equipped' in request.resource.data) || request.resource.data.equipped is map);
    }

    // Chat global — un joueur connecté peut lire tous les messages et en
    // écrire de nouveaux, mais jamais les modifier ni les supprimer
    // (messages immuables, pas d'édition a posteriori). hasOnly() +
    // bornes de taille limitent l'abus ; le filtre anti-spam/insultes
    // réel vit côté client (le serveur ne fait que borner la forme).
    match /chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','text','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 240
        && request.resource.data.createdAt == request.time
        && ( !exists(/databases/$(database)/documents/chatMeta/$(request.auth.uid))
             || request.time > get(/databases/$(database)/documents/chatMeta/$(request.auth.uid)).data.lastMessageAt + duration.value(2, 's') );
      allow update, delete: if false;
    }

    // Horodatage du dernier message envoyé par joueur — sert uniquement
    // au throttle serveur ci-dessus (défense en profondeur derrière le
    // cooldown déjà appliqué côté client).
    match /chatMeta/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['lastMessageAt'])
        && request.resource.data.lastMessageAt == request.time;
    }
  }
}
