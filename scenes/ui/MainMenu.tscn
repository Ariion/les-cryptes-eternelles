[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/MainMenu.gd" id="1"]

[node name="MainMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

; Fond noir profond
[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.051, 0.039, 0.078, 1)

; Effet de vignette (assombrit les bords)
[node name="Vignette" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.5)
modulate = Color(1, 1, 1, 0.45)

[node name="VBox" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -170.0
offset_top = -250.0
offset_right = 170.0
offset_bottom = 250.0
theme_override_constants/separation = 14

; --- TITRE ---
[node name="TitleLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
text = "LES CRYPTES\nÉTERNELLES"
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(0.784, 0.588, 0.227, 1)
autowrap_mode = 1

[node name="SubtitleLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
text = "Le donjon n'a pas de mémoire."
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.55, 0.52, 0.48, 1)
autowrap_mode = 3

[node name="Sep1" type="HSeparator" parent="VBox"]

[node name="GoldLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
text = "Trésor : 0 pièces d'or"
theme_override_colors/font_color = Color(0.784, 0.588, 0.227, 1)

[node name="RunsLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
text = "Expéditions : 0"
theme_override_colors/font_color = Color(0.55, 0.52, 0.48, 1)

[node name="Sep2" type="HSeparator" parent="VBox"]

; --- BOUTONS ---
[node name="PlayBtn" type="Button" parent="VBox"]
custom_minimum_size = Vector2(340, 64)
text = "DESCENDRE DANS LES CRYPTES"
theme_override_font_sizes/font_size = 17

[node name="ShopBtn" type="Button" parent="VBox"]
custom_minimum_size = Vector2(340, 52)
text = "Améliorer l'équipement"

[node name="SettingsBtn" type="Button" parent="VBox"]
custom_minimum_size = Vector2(340, 52)
text = "Paramètres"

[node name="VersionLabel" type="Label" parent="VBox"]
horizontal_alignment = 1
text = "v0.1 — Music: Kevin MacLeod (CC BY 4.0)"
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.3, 0.28, 0.25, 1)

[connection signal="pressed" from="VBox/PlayBtn" to="." method="_on_play_btn_pressed"]
[connection signal="pressed" from="VBox/ShopBtn" to="." method="_on_shop_btn_pressed"]
[connection signal="pressed" from="VBox/SettingsBtn" to="." method="_on_settings_btn_pressed"]
