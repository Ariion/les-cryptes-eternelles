[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/HUD.gd" id="1"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

; --- HAUT ---
[node name="Top" type="Panel" parent="."]
anchors_preset = 13
anchor_right = 1.0
offset_bottom = 52.0

[node name="HBox" type="HBoxContainer" parent="Top"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_right = -8.0
offset_top = 4.0
offset_bottom = -4.0
theme_override_constants/separation = 8

[node name="HpBar" type="ProgressBar" parent="Top/HBox"]
size_flags_horizontal = 3
custom_minimum_size = Vector2(120, 28)
value = 100.0
show_percentage = false

[node name="HpLabel" type="Label" parent="Top/HBox/HpBar"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
horizontal_alignment = 1
vertical_alignment = 1
theme_override_font_sizes/font_size = 12
text = "100 / 100"

[node name="GoldLabel" type="Label" parent="Top/HBox"]
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(1.0, 0.85, 0.2, 1)
text = "Or: 0"

[node name="FloorLabel" type="Label" parent="Top/HBox"]
size_flags_horizontal = 3
horizontal_alignment = 2
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.7, 0.7, 1.0, 1)
text = "Etage 1 - 1/7"

[node name="StatusBar" type="HBoxContainer" parent="Top/HBox"]
custom_minimum_size = Vector2(0, 24)
theme_override_constants/separation = 4

; --- MILIEU ---
[node name="Middle" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_top = 0.07
anchor_right = 1.0
anchor_bottom = 0.72
grow_vertical = 2
offset_top = 4.0

[node name="EnemyContainer" type="HBoxContainer" parent="Middle"]
custom_minimum_size = Vector2(0, 48)
alignment = 1
theme_override_constants/separation = 16

[node name="LogScroll" type="ScrollContainer" parent="Middle"]
size_flags_vertical = 3

[node name="LogContainer" type="VBoxContainer" parent="Middle/LogScroll"]
size_flags_horizontal = 3

[node name="MessageLabel" type="Label" parent="Middle"]
horizontal_alignment = 1
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(1.0, 0.9, 0.5, 1)
text = ""

[node name="DoubleLootPanel" type="Panel" parent="Middle"]
visible = false
custom_minimum_size = Vector2(0, 100)

[node name="VBox" type="VBoxContainer" parent="Middle/DoubleLootPanel"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
alignment = 1

[node name="Label" type="Label" parent="Middle/DoubleLootPanel/VBox"]
horizontal_alignment = 1
text = "Doubler le butin ?"

[node name="WatchAdBtn" type="Button" parent="Middle/DoubleLootPanel/VBox"]
text = "Regarder une pub (+30s)"

[node name="SkipBtn" type="Button" parent="Middle/DoubleLootPanel/VBox"]
text = "Non merci"

; --- BAS : boutons de combat ---
[node name="Bottom" type="Panel" parent="."]
anchors_preset = 15
anchor_top = 0.72
anchor_right = 1.0
anchor_bottom = 1.0
grow_vertical = 2

[node name="Grid" type="GridContainer" parent="Bottom"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_right = -8.0
offset_top = 8.0
offset_bottom = -8.0
columns = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="AttackBtn" type="Button" parent="Bottom/Grid"]
size_flags_horizontal = 3
size_flags_vertical = 3
text = "Attaquer"

[node name="DefendBtn" type="Button" parent="Bottom/Grid"]
size_flags_horizontal = 3
size_flags_vertical = 3
text = "Defendre"

[node name="ItemBtn" type="Button" parent="Bottom/Grid"]
size_flags_horizontal = 3
size_flags_vertical = 3
text = "Objet"

[node name="FleeBtn" type="Button" parent="Bottom/Grid"]
size_flags_horizontal = 3
size_flags_vertical = 3
text = "Fuir"

[connection signal="pressed" from="Bottom/Grid/AttackBtn" to="." method="_on_attack_btn_pressed"]
[connection signal="pressed" from="Bottom/Grid/DefendBtn" to="." method="_on_defend_btn_pressed"]
[connection signal="pressed" from="Bottom/Grid/ItemBtn" to="." method="_on_item_btn_pressed"]
[connection signal="pressed" from="Bottom/Grid/FleeBtn" to="." method="_on_flee_btn_pressed"]
[connection signal="pressed" from="Middle/DoubleLootPanel/VBox/WatchAdBtn" to="." method="_on_watch_ad_btn_pressed"]
[connection signal="pressed" from="Middle/DoubleLootPanel/VBox/SkipBtn" to="." method="_on_skip_btn_pressed"]
